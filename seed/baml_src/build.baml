// Build entry point: config -> boards -> .kicad_pcb -> DRC.
//
//   baml run build            the boards, with per-key LEDs fitted
//
// The LED variant is the only one built: leaving the LEDs off an assembled
// board needs no PCB change, so a second no-LED output was just twice the
// files. The no-LED Features still exist -- the derivation tests pin the
// hand-derived numbers in v2-p4-pod.md against them.
//
// Deterministic: same config in, byte-identical boards out.

/// A project footprint table beside the emitted boards.
///
/// KiCad resolves `rosebear:` against the tables it can see, and a bare
/// .kicad_pcb sees only the one in its own directory. `up` is how far back to
/// the repo root from there.
function write_lib_table(outdir: string, up: string) -> void throws baml.errors.Io {
    baml.fs.write(
        `${outdir}/fp-lib-table`,
        [
            "(fp_lib_table",
            "\t(version 7)",
            `\t(lib (name "${LOCAL_FOOTPRINT_LIB()}")(type "KiCad")(uri "\${KIPRJMOD}/${up}${LOCAL_FOOTPRINT_ROOT()}/${LOCAL_FOOTPRINT_LIB()}.pretty")(options "")(descr "Generated by v3/footprints/gen_hotswap.py"))`,
            ")",
            "",
        ]
            .join("\n"),
    )
}

/// Copper-to-board-edge clearance, in millimetres.
///
/// 0.5mm is the sensible default and what the base variant is routed to. The
/// LED variant has to run looser, and not because of anything routed here: the
/// SK6812MINI-E footprint mills a window for the light to come up through, and
/// KiCad's own footprint puts the LED's four pads 0.239mm from the edge of it.
/// That is the part's own land pattern, so the rule has to accommodate it.
function edge_clearance(f: Features) -> string {
    if (f.per_key_leds) {
        "0.2"
    } else {
        `${BOARD_EDGE_CLEAR()}`
    }
}

/// Design rules that differ from KiCad's defaults, as JSON fields.
///
/// The segmented variant runs finer than the rigid one and has to say so: a
/// neck 1.6mm wide carrying four conductors has no room for 0.2mm tracks at
/// 0.2mm clearance, and its edges are 0.3mm from copper by construction. These
/// are the numbers `flex.baml` sizes everything from, not a relaxation applied
/// afterwards to make DRC quiet.
function design_rules(f: Features) -> string[] {
    if (f.flex) {
        [
            `\t\t\t\t"min_clearance": ${FLEX_TRACE_SPACE()}`,
            `\t\t\t\t"min_copper_edge_clearance": ${FLEX_EDGE_CLEAR()}`,
            `\t\t\t\t"min_track_width": ${FLEX_TRACE_W()}`,
            `\t\t\t\t"min_via_diameter": ${FLEX_VIA_PAD()}`,
        ]
    } else {
        [`\t\t\t\t"min_copper_edge_clearance": ${edge_clearance(f)}`]
    }
}

/// The same number, for the geometry that has to respect it.
///
/// `flex.baml` sizes a column strip so the switch socket's pads clear the strip
/// edge by this much, so the placement and the rule DRC checks cannot drift.
function BOARD_EDGE_CLEAR() -> float {
    0.5
}

/// A project file per board, carrying the design rules DRC checks against.
/// The default net class: what a track actually gets checked against.
///
/// `design_rules` sets the board minimums; those are a floor, not the rule DRC
/// applies. Clearance and width come from the net class, so the fine variant
/// has to say it twice or DRC checks the fine geometry against the coarse
/// default.
function net_class(f: Features) -> string[] {
    if (f.flex) {
        [
            "\t\"net_settings\": {",
            // KiCad ignores a net_settings block with no schema version on it,
            // silently, and checks the fine geometry against the coarse
            // defaults instead.
            "\t\t\"meta\": { \"version\": 4 },",
            "\t\t\"classes\": [",
            "\t\t\t{",
            "\t\t\t\t\"name\": \"Default\",",
            `\t\t\t\t"clearance": ${FLEX_TRACE_SPACE()},`,
            `\t\t\t\t"track_width": ${FLEX_TRACE_W()},`,
            `\t\t\t\t"via_diameter": ${FLEX_VIA_PAD()},`,
            `\t\t\t\t"via_drill": ${FLEX_VIA_DRILL()}`,
            "\t\t\t}",
            "\t\t]",
            "\t},",
        ]
    } else {
        []
    }
}

function write_project(path: string, id: string, f: Features) -> void throws baml.errors.Io {
    baml.fs.write(
        `${path}/${id}.kicad_pro`,
        [
            "{",
            "\t\"board\": {",
            "\t\t\"design_settings\": {",
            "\t\t\t\"rules\": {",
            design_rules(f).join(",\n"),
            "\t\t\t}",
            "\t\t}",
            "\t},",
        ]
            .concat(net_class(f))
            .concat([`\t"meta": { "filename": "${id}.kicad_pro", "version": 3 }`, "}", ""])
            .join("\n"),
    )
}
