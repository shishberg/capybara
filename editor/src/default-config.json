    ]
  },
  "wiring": {
    "provisional": true,
    "description": "Hand wiring from the tile holes and pads to the Pro Micro's pins, as a 4 x 5 matrix: rows RT, RH, RB and RX (the thumbs), columns C0 (pinky) to C4 (inner). Each thumb shares a finger column but has its own wire to that column's pin. One wire per tile hole or pad: each row and column wire arrives at one of the tile's two R (or C) holes and the next leaves from the other; +5 V and GND use the V (or G) hole and the LED-edge pad. LED data follows led_order, in to out. Each net's feeds land on the Pro Micro pin pro_micro.pins gives it.",
    "signal_wire_mm": 0.6,
    "power_wire_mm": 0.9,
    "loom_height_mm": 10,
    "port_diameter_mm": 5,
    "port_length_mm": 20,
    "service_loop_mm": 40,
    "end_allowance_mm": 5,
    "solder_access_mm": [2, 8],
